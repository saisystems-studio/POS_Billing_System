# # ──────────────────────────────────────────────────────
# # POS Frontend — Environment Variables (example)
# # Copy this file to .env and fill in your values.
# # .env is git-ignored; .env.example should be committed.
# # ──────────────────────────────────────────────────────

# # Backend API base URL (no trailing slash)
# VITE_API_BASE_URL=http://localhost:8000/api

# # App display name
# VITE_APP_NAME=POS Billing System

# # App version
# VITE_APP_VERSION=1.0.0


# ──────────────────────────────────────────────────────
# POS Frontend — Production build environment
# Used automatically by Vite ONLY during `npm run build`.
# Do not use this for `npm run dev` — that still reads .env.
# ──────────────────────────────────────────────────────

# Backend API base URL — relative, not absolute.
# Frontend and backend are served from the same Django origin in the
# packaged build, so this must NOT be http://localhost:8000/api —
# that would break the moment the app runs on a different port or PC.
VITE_API_BASE_URL=/api

# App display name
VITE_APP_NAME=POS Billing System

# App version
VITE_APP_VERSION=1.0.0