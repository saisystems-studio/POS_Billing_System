# Django Settings — copy to .env and adjust if needed
SECRET_KEY=your-secret-key-here-use-at-least-50-random-characters
DEBUG=True

# Database — SQL Server SQLEXPRESS with Windows Authentication
# No username or password required (Windows Auth handles it)
DB_NAME=BanustoresPOS_db
DB_SERVER=.\SQLEXPRESS
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_DRIVER=ODBC Driver 17 for SQL Server
DB_EXTRA_PARAMS=Trusted_Connection=yes;Encrypt=yes;TrustServerCertificate=yes;

# CORS — set to your frontend URL
FRONTEND_URL=http://localhost:5173
